rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A user is staff if they logged in via the Faculty Portal (JWT has isStaff)
    // OR if their auth.uid physically exists in the staff_credentials collection
    // OR if they are the Super Admin who logged in via Google (users doc role is admin)
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.get('isStaff', false) == true ||
        exists(/databases/$(database)/documents/staff_credentials/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId) 
        && request.resource.data.get('hasEntryPass', false) == false
        && request.resource.data.get('hasHackathonPass', false) == false
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isStaff', false) == false
        && request.resource.data.get('aftCoins', 0) == 0;
      
      allow update: if isStaff() || (isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'aftCoins', 'isStaff']))
        && (request.resource.data.get('hasEntryPass', false) == resource.data.get('hasEntryPass', false) || resource.data.get('hasEntryPass', false) == true)
        && (request.resource.data.get('hasHackathonPass', false) == resource.data.get('hasHackathonPass', false) || resource.data.get('hasHackathonPass', false) == true)
        && (request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', 'pending')) != 'success' || resource.data.get('paymentStatus', 'pending') == 'success')
        && (request.resource.data.get('completed', resource.data.get('completed', false)) != true || resource.data.get('completed', false) == true));
        
      allow delete: if false; 
    }

    // --- COLLECTION GROUP: REGISTRATIONS ---
    match /{path=**}/registrations/{userId} {
      allow read, list: if isAuthenticated();
      
      allow create: if isOwner(userId);
        
      allow update: if isStaff() || (isOwner(userId)
        && (request.resource.data.get('hasEntryPass', false) == resource.data.get('hasEntryPass', false) || resource.data.get('hasEntryPass', false) == true)
        && (request.resource.data.get('hasHackathonPass', false) == resource.data.get('hasHackathonPass', false) || resource.data.get('hasHackathonPass', false) == true)
        && (request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', 'pending')) != 'success' || resource.data.get('paymentStatus', 'pending') == 'success')
        && (request.resource.data.get('completed', resource.data.get('completed', false)) != true || resource.data.get('completed', false) == true));
    }

    // --- EVENTS COLLECTION ---
    match /events/{eventId} {
      allow read: if true;
      allow write: if isStaff(); 
    }

    // --- TEAMS COLLECTION ---
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // --- HACKATHON TEAMS ---
    match /hackathon_teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.get('paymentStatus', '') == 'pending';
      allow update: if isStaff() || (isAuthenticated()
        && (request.resource.data.get('paymentStatus', 'pending') != 'success' || resource.data.get('paymentStatus', 'pending') == 'success'));
    }
    
    match /reg_hackathon/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('paymentStatus', '') == 'pending';
      allow update: if isStaff() || (isAuthenticated() 
        && (request.resource.data.get('paymentStatus', 'pending') != 'success' || resource.data.get('paymentStatus', 'pending') == 'success'));
    }

    // --- HACKATHON PASSES ---
    match /hackathon_passes/{passId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // --- FREEFIRE TEAMS ---
    match /freefire_teams/{teamId} {
      allow read: if isStaff() || (isAuthenticated() && (
        resource == null || 
        request.auth.uid == resource.data.leaderId || 
        request.auth.uid in resource.data.memberIds
      ));
      allow create: if isAuthenticated() 
        && request.resource.data.get('paymentStatus', '') == 'pending';
      allow update: if isStaff() || (isAuthenticated()
        && (request.resource.data.get('paymentStatus', 'pending') != 'success' || resource.data.get('paymentStatus', 'pending') == 'success'));
    }

    // --- WALLETS & ORDERS ---
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isStaff();
      allow write: if false; 
    }

    match /order_history/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if false; 
    }

    // --- PUBLIC/MISC COLLECTIONS ---
    match /notifications/{notiId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if false;
    }

    match /staff_credentials/{staffId} {
      // Any staff can read (to verify login)
      allow read: if isStaff();
      // Only super-admin (Google user with role=admin) can create or delete staff accounts
      allow create, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // No one can update staff credentials via client (use admin panel API)
      allow update: if false;
    }
    
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if false; 
      
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(memberId);
        allow update, delete: if isOwner(memberId) || isStaff();
      }
    }
    
    match /classes/{classId} {
      allow read: if isStaff(); 
      allow write: if false;
    }

    // --- ADMIN / CMS DATA ---
    match /cms_content/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /landing_carousel/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /event_categories/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /system/{docId} {
      allow read: if isStaff() || isOwner(docId);
      allow write: if isStaff();
    }
    
    match /team_members/{docId} {
      allow read: if true; 
      allow write: if isStaff();
    }

    // --- SECONDARY EVENT COLLECTIONS ---
    match /hackathon/{docId} {
      allow read: if isOwner(docId) || isStaff();
      allow create: if isOwner(docId);
      allow update: if isOwner(docId)
        && (request.resource.data.get('paymentStatus', 'pending') != 'success' || resource.data.get('paymentStatus', 'pending') == 'success')
        && (request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending'))
        && (request.resource.data.get('passTokens', []) == resource.data.get('passTokens', []));
    }

    // --- TRANSACTIONS & ACCESS LOGS ---
    match /transactions/{docId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isStaff() || (
        isAuthenticated() 
        && request.auth.uid == resource.data.userId
        && (request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending'))
        && (request.resource.data.get('paytmTxnId', '') == resource.data.get('paytmTxnId', ''))
        && (request.resource.data.get('verifiedByServer', false) == resource.data.get('verifiedByServer', false))
      );
    }
    
    match /access_logs/{docId} {
      allow read: if isStaff();
      allow create: if isStaff(); 
      allow update, delete: if false; 
    }

    match /messages/{channel}/chats/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isStaff();
    }
  }
}
