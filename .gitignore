# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.keystore
*.jks

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env & secrets
.env*
firebase-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test/maintenance scripts & data dumps
*.xlsx
*.csv
auth_history.txt
headers.txt
postman/
.postman/
tmp/
scripts/
test-team.ts

# ignore root audit / scratch javascript files (keep root configs)
*.js
!next.config.js
!tailwind.config.js
!postcss.config.js

# ignore root scratch JSON data dumps (keep configuration JSONs)
*.json
!package.json
!package-lock.json
!tsconfig.json
!components.json
!capacitor.config.json

# Android build outputs & local properties
android/local.properties
android/.gradle/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/capacitor-cordova-android-plugins/.gradle/
